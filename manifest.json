{
  "manifest_version": 3,
  "name": "AidTune",
  "version": "0.16",
  "description": "Adds a page to the Intune portal showing your nested Entra groups as a tree, with markers for assigned apps and configurations.",
  "permissions": [
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://intune.microsoft.com/*",
    "https://graph.microsoft.com/*",
    "https://*.manage.microsoft.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "AidTune — open in the Intune portal",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://intune.microsoft.com/*"
      ],
      "js": [
        "src/content/token-scan.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://intune.microsoft.com/*"
      ],
      "js": [
        "src/content/portal-nav.js"
      ],
      "css": [
        "src/content/portal-nav.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/page/page.html"
      ],
      "matches": [
        "https://intune.microsoft.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
